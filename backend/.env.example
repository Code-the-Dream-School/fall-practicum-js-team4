PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017/mydb

# PostgreSQL
POSTGRES_URI=postgresql://user:password@localhost:5432/mydb

# PostgreSQL (Prisma): use ONE of these
# Local Postgres:
DATABASE_URL=postgresql://user:password@localhost:5432/pawradar?schema=public
# Neon (hosted): Dashboard -> Connect, with "Connection pooling" turned OFF
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth (see docs/auth.md)
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id
# Frontend origin allowed to send the auth cookie
CLIENT_URL=http://localhost:5173
# lax (default), strict, or none (none requires HTTPS)
COOKIE_SAME_SITE=lax
