{
  "name": "basic-backend-api",
  "version": "1.1.0",
  "description": "Node + Express backend API",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest --testPathPatterns=test/ --verbose --maxWorkers=1 --detectOpenHandles --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "express-xss-sanitizer": "^2.0.2",
    "google-auth-library": "^11.3.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
